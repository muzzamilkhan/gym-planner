# Pooled connection — used by the app at runtime.
DATABASE_URL="postgresql://user:password@localhost:5432/gym_planner"

# Unpooled/direct connection — used by `prisma migrate` only.
# On Neon this is the same URL with `-pooler` removed from the host.
# For a plain local Postgres (no pooler) set it to the same value as DATABASE_URL.
DIRECT_URL="postgresql://user:password@localhost:5432/gym_planner"
