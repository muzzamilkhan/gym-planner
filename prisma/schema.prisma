generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled (PgBouncer) endpoint for runtime queries.
  url       = env("DATABASE_URL")
  // Unpooled endpoint — migrations need DDL and advisory locks,
  // which are unreliable through a transaction pooler.
  directUrl = env("DIRECT_URL")
}

model Program {
  id        String   @id @default(cuid())
  editId    String   @unique
  viewId    String   @unique
  data      Json
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
